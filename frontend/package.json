{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "preview": "vite preview",
    "build": "vite build",
    "dev": "vite",
    "format": "prettier --write \"src/**/*.{js,ts,vue,json,css,scss,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue,json,css,scss,html}\"",
    "lint": "eslint \"src/**/*.{js,ts,vue}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,ts,vue}\"",
    "lint:api-refs": "node scripts/check-api-refs.cjs",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:gate": "node scripts/check-types.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vueuse/core": "^11.3.0",
    "axios": "^1.11.0",
    "dayjs": "^1.11.10",
    "dompurify": "^3.4.14",
    "echarts": "^6.1.0",
    "element-plus": "^2.4.4",
    "html2canvas": "^1.4.1",
    "nprogress": "^0.2.0",
    "pinia": "^2.1.7",
    "vue": "^3.5.34",
    "vue-echarts": "^8.1.0",
    "vue-router": "^4.2.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.20.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^3.2.6",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.28.0",
    "jsdom": "^24.1.0",
    "prettier": "^3.3.3",
    "sass": "^1.100.0",
    "typescript": "^5.4.5",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.12",
    "vitest": "^3.2.6",
    "vue-tsc": "2.2.10"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.18",
    "dompurify": "^3.4.14",
    "editorconfig": {
      "minimatch": "^9.0.7"
    },
    "glob": {
      "minimatch": "^9.0.7"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.7"
    }
  }
}
