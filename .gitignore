# 环境变量文件（含敏感密钥，切勿提交）
.env
.env.local
.env.*.local
# 文件式密钥文件（Docker Compose secrets / Vault Agent 渲染目标，禁止入库）
deploy/secrets/*
!deploy/secrets/.gitkeep

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

# 构建产物
target/
dist/
node_modules/
# 运维数据（含敏感数据，切勿提交）
# 应用内「系统管理→备份」生成的 SQL 备份（SystemServiceImpl backups/ 目录）
backups/
# mysql-backup 服务的定时备份卷数据
mysql-backups/
# 运行时生成的数据库文件
*.sql.gz

# 评测产物（含评测运行结果与 QA 记录）
evaluation/results/

# 运行日志与压测瞬时产物（体积大、无复现价值，切勿提交）
# 注：calibration/samples.jsonl 与 calibration_data.json 为校准数据集，需入库保留
*.log
*.out

# Python 缓存/字节码（构建产物，切勿提交）
__pycache__/
*.pyc
*.pyo
*.pyd

# 本地调试/临时文件（勿提交）
backend/analyze.py
backend/parse_errors.py
backend/cp.txt
backend/err_compile.txt
backend/jc.args
backend/jc2.txt
backend/lqwtest/
*.bak
*~
frontend/coverage/

# WorkBuddy 项目数据（记忆/任务，勿入库）
.workbuddy/
# WorkBuddy 过程性工作区（调试脚本、探针、构建输出，可随时清空）
.workbuddy/tmp/

# 应用运行期上传目录（内容为运行时产物，仅保留目录占位）
uploads/*
!uploads/.gitkeep

# 临时补丁与差异文件（过程产物）
*.patch
*.diff

# 构建探针产物（误提交，已清理）
frontend/dist_probe/

# e2e 产物
frontend/playwright-report/
frontend/test-results/
scripts/e2e/e2e_*result.json
# 安全/深度/压力脚本按当前工作目录落盘，从仓库根跑时会留在根目录；只锚定根目录，
# 以免误伤 archive/deliverables/ 下同名的人工快照（那些是跟踪文件）
/e2e_*result.json

# ---- Python 虚拟环境与数据目录 ----
venv/
.venv/
/data/
# RAG 真实引擎持久化数据（文档存储 + BM25/向量索引）
python-services/rag_service/data/

# ---- 凭据工件：curl 会话 Cookie 罐（含 HttpOnly access/refresh JWT），严禁入库 ----
# calibration/cj.txt 曾被误提交（80553eb，令牌已过期）；历史提交仍含该文件，需另行清理
calibration/cj.txt
**/cookies.txt
**/cookie.jar
