# ============================================================
# 生产环境配置模板（A 路径 #7 / #8）
#
# 用法：
#   cp deploy/env.production.template deploy/env.production
#   # 填值后放到主机 DEPLOY_PATH/.env，再跑：
#   python scripts/check-required-env.py --env-file .env
#   python scripts/check-https-ws-config.py --env-file .env --domain <真实域名>
#
# 重要：
#   - 带 <...> 的项必须替换为真实值；脚本会把占位值判为 FAIL。
#   - 本模板不包含任何真实密码、域名或证书。不要把填写后的文件提交到仓库。
#   - 未配置真实域名与证书前，HTTPS/Cookie/WS Origin 只能做静态检查，
#     运行期验收仍挂账（A 路径 #7/#8）。
#   - 六个 ${VAR:?...} 必填键中，NEO4J_PASSWORD 与 MYSQL_APP_PASSWORD
#     必须人工填；其余由 scripts/generate-secrets.py 生成（见 A 路径 #5）。
# ============================================================

# ---------- 必填凭证（scripts/generate-secrets.py 生成 5 个；NEO4J 人工填） ----------
MYSQL_ROOT_PASSWORD=<由 generate-secrets.py 生成>
MYSQL_APP_PASSWORD=<人工填：应用库专用口令，建议至少 18 位随机>
REDIS_PASSWORD=<由 generate-secrets.py 生成>
JWT_SECRET=<由 generate-secrets.py 生成，UTF-8 ≥32 字节>
APP_ADMIN_INITIAL_PASSWORD=<由 generate-secrets.py 生成，必须过 PasswordPolicy>
NEO4J_PASSWORD=<人工填：generate-secrets.py 不生成>
GRAFANA_ADMIN_PASSWORD=<由 generate-secrets.py 生成>

# ---------- HTTPS / Cookie / CSRF（A 路径 #7） ----------
# 生产必须是 true；只有受信内网纯 HTTP 评估才允许两项同时 false。
REQUIRE_HTTPS=true
COOKIE_SECURE=true
CSRF_ENABLED=true

# 反向代理（nginx/Caddy）必须传 X-Forwarded-Proto / X-Forwarded-For；
# 否则 $REQUIRE_HTTPS 校验会看到 http，导致重定向循环或 Cookie 标志错误。
TRUST_PROXY_HEADER=true

# ---------- Origin 白名单（A 路径 #8；REST 与 WebSocket 共用） ----------
# 只写 scheme://host[:port]，逗号分隔；不得含 http://、localhost、* 或路径。
CORS_ALLOWED_ORIGINS=https://<真实域名>
# 生产必须 false：关闭 localhost 兜底，否则白名单为空时会放行本机来源。
APP_CORS_DEV_FALLBACK=false

# ---------- 监控端点鉴权 ----------
APP_ACTUATOR_BASIC_PASSWORD=<由 generate-secrets.py 生成>

# ---------- 邮件真实通道（可选；不配则验证码走日志降级） ----------
MAIL_HOST=<smtp.example.com>
MAIL_PORT=465
MAIL_USERNAME=<no-reply@example.com>
MAIL_PASSWORD=<人工填>
MAIL_FROM=<no-reply@example.com>
MAIL_SSL_ENABLED=true
# 465 用 SSL；587 用 STARTTLS，二者互斥。
MAIL_STARTTLS_ENABLED=false

# ---------- 引擎地址（按需启用 profiles: python） ----------
KG_BASE_URL=http://kg-service:8001
RAG_BASE_URL=http://rag-service:8002
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_OFFLINE=0
RAG_EMBED_MODEL=BAAI/bge-small-zh-v1.5
AI_PROVIDER=deepseek

# ---------- 备份 ----------
BACKUP_RETENTION_DAYS=14
# 异地同步当前只是骨架（镜像未装 rclone），留空即不启用；
# 方案见 docs/异地备份与TLS件方案骨架.md。
BACKUP_REMOTE_SYNC=

# 其余键（端口、日志、限流、微调 provider 等）见仓库根 .env.example。
