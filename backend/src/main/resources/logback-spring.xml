<?xml version="1.0" encoding="UTF-8"?>
<!--
  统一日志配置（2026-11-07 验收整改批引入）。
  此前仓库内无 logback 配置，日志只进控制台（容器 stdout），宿主机排障依赖 docker logs；
  现补齐文件落盘 + 按天/按大小滚动 + 压缩归档 + 总量上限：
  - 默认（dev/测试）：仅 CONSOLE，行为与 Spring Boot 默认一致，不产生文件；
  - prod profile（docker-compose SPRING_PROFILES_ACTIVE=prod）：追加 FILE 落盘，
    路径由 app.log.path（环境变量 APP_LOG_PATH，relaxed binding）控制，默认 ./logs。
  级别覆盖仍走 application.yaml 的 logging.level.com.aicourse（LOG_LEVEL_COM_AICOURSE），
  由 Spring Boot 在本配置之后程序化应用，两者叠加不冲突。
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <springProperty scope="context" name="AICP_LOG_PATH" source="app.log.path" defaultValue="logs"/>

    <!-- 2026-11-14 P2-9/N5：在 Boot 默认 CONSOLE/FILE 模板上前置定义含 traceId 的覆盖版
         （defaults.xml 的属性定义带 :- 默认值，此处先定义即优先生效）。TraceIdFilter 把
         请求级 traceId 写入 MDC；无请求上下文（启动日志/调度器）时显示为空占位。 -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr([%X{traceId:-}]){faint} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>
    <property name="FILE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%X{traceId:-}] [%t] %-40.40logger{39} : %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <springProfile name="prod">
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${AICP_LOG_PATH}/aicourse-backend.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <!-- 按天滚动，单文件超 50MB 切分，历史压缩为 .gz -->
                <fileNamePattern>${AICP_LOG_PATH}/aicourse-backend.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>50MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>2GB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>${FILE_LOG_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>
</configuration>
