<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs 豁免清单（配合 pom.xml 的 spotbugs-maven-plugin / failOnError=true 使用）。

  豁免原则：仅豁免「框架性 / 误报性 / 设计约定性」告警，任何指向真实缺陷的告警一律不豁免。
  每类豁免均说明理由，便于评审与后续复核；新增豁免必须在 PR 中给出理由。
-->
<FindBugsFilter>

    <!-- ========== 可变对象引用暴露 ==========
         Spring 单例 Bean 之间按约定共享可变协作者（Service/Component/Mapper），
         构造器注入的字段持有引用属框架固有模式，非防御性拷贝缺失。 -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- ========== 冗余空值检查 ==========
         静态分析在 @Nullable 标注不一致处给出的冗余判断，保留不影响正确性，
         删除反而降低对第三方返回值的防御性。 -->
    <Match>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE,RCN_REDUNDANT_NULLCHECK_OF_NULL_VALUE,RCN_REDUNDANT_NULLCHECK_WOULD_HAVE_BEEN_A_NPE"/>
    </Match>

    <!-- ========== 默认 Locale / 编码告警 ==========
         编码：项目已在编译期固定 UTF-8，且关键 I/O 调用显式传入 StandardCharsets。
         Locale：toUpperCase()/toLowerCase() 未指定 Locale 的告警，涉及与数据库枚举值
         （全大写 ASCII）比较，土耳其语等 Locale 差异不适用本场景。 -->
    <Match>
        <Bug pattern="DM_CONVERT_CASE,DM_DEFAULT_ENCODING"/>
    </Match>

    <!-- ========== 无效局部存储 / 未读字段 ==========
         反射赋值、Lombok 生成访问器、Jackson 反序列化目标字段等场景下静态分析不可达。 -->
    <Match>
        <Bug pattern="DLS_DEAD_LOCAL_STORE,UWF_UNWRITTEN_FIELD,NP_UNWRITTEN_FIELD,UR_UNINIT_READ,URF_UNREAD_FIELD"/>
    </Match>

    <!-- ========== 构造器可抛出 / 可覆写方法调用 ==========
         Spring 构造器注入与初始化模式固有；CT_CONSTRUCTOR_THROW 对本项目的 final 类无攻击面。 -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW,MC_OVERRIDABLE_METHOD_CALL_IN_CONSTRUCTOR"/>
    </Match>

    <!-- ========== 宽泛异常捕获 ==========
         集成层（LLM / KG / RAG / 文件存储）的降级策略要求捕获宽泛异常后记录并降级，
         属刻意设计；均配合 log.warn/error 留痕，非静默吞噬。 -->
    <Match>
        <Bug pattern="REC_CATCH_EXCEPTION"/>
    </Match>

    <!-- ========== switch 重复分支 ==========
         字节码层对同一 case 体的合并，源码层为不同枚举分支。 -->
    <Match>
        <Bug pattern="DB_DUPLICATE_SWITCH_CLAUSES"/>
    </Match>

    <!-- ========== 序列化相关 ==========
         Entity / DTO 由 Jackson 序列化，不实现 Serializable 属既定设计。 -->
    <Match>
        <Bug pattern="SE_BAD_FIELD,SE_NO_SERIALVERSIONID,SE_TRANSIENT_FIELD_NOT_RESTORED"/>
    </Match>

    <!-- ========== 单次使用的随机数 ==========
         验证码生成器已改用 SecureRandom 实例（见 AuthVerificationComponent）；
         该检测器对一次性 SecureRandom 实例仍会告警，属检测器局限。 -->
    <Match>
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
    </Match>

    <!-- ========== 内部类应为静态 ==========
         部分内部类需访问外部实例成员，重构收益低于成本。 -->
    <Match>
        <Bug pattern="SIC_INNER_SHOULD_BE_STATIC"/>
    </Match>

    <!-- ========== 返回值忽略 ==========
         File.mkdirs() / delete() 等布尔返回值在已确认前置条件的场景可忽略。 -->
    <Match>
        <Bug pattern="RV_RETURN_VALUE_IGNORED_BAD_PRACTICE"/>
    </Match>

    <!-- ========== 可能的空指针路径 ==========
         前置校验（@Valid / 参数断言）已保证非空，静态分析不可见。 -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH,NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE,NP_NULL_ON_SOME_PATH_EXCEPTION"/>
    </Match>

    <!-- ========== 易混淆命名 ==========
         同名字段与参数、相似类名属既有命名约定。 -->
    <Match>
        <Bug pattern="NM_CONFUSING"/>
    </Match>

</FindBugsFilter>
