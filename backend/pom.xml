        <!-- Sentinel 流量控制与熔断降级（纯 core + 注解切面，无 servlet 依赖，兼容 JDK21/Spring Boot3，不引入 Spring Cloud） -->
        <sentinel.version>1.8.9</sentinel.version>

        <!-- 安全升级：覆盖 Spring Boot 3.5.15 管理的传递依赖版本，
             修复 2026-06 后新披露、3.5.15 尚未收录的 CVE（OSV-Scanner/Trivy 门禁命中的真实漏洞）。
             2026-10-07 复核（本机按 OSV API 逐包实跑，见手册 §24.2.3 根因 B）：
               · jackson 2.21.5 → 2.21.7 关闭 CVE-2026-89425/89407（core）与 CVE-2026-91777/68497/91776（databind）；
               · tomcat 新增覆盖到 10.1.60：三条 Tomcat CRITICAL 的 OSV 修复版记为 10.1.58，
                 而 10.1.58 **确实从未发布到 Maven Central**（10.1.x 实际存在 10.1.56/57/59/60），
                 故取「≥ 修复版且已发布」的 10.1.60；升级后 10.1.60 在 OSV 查询为 0 命中，
                 .trivyignore / osv-scanner.toml 的三条 Tomcat 豁免已据实删除（不是追加新豁免）。
             ⚠️ 仍无法升级的三条 spring-framework CVE：6.2.x 线**均无修复版**
             （NVD 影响范围 6.2.0–6.2.19，唯一修复版 7.0.9；升 7.x 需 Spring Boot 4，超出本轮范围）：
               · CVE-2026-47884（XsltView SSRF/RCE）——需 XsltView + 未指定视图名的 /** 渲染；
               · CVE-2026-47890（SSE + view fragments 的流损坏，CRITICAL）——需 SSE 叠加视图片段渲染；
               · CVE-2026-47892（WebFlux functional endpoints 的 Header Predicate 绕过）——需 WebFlux 函数式端点。
             三条均按「触发路径不可达」精确豁免，逐条论证见 backend/osv-scanner.toml 与 .trivyignore。 -->
        <netty.version>4.1.137.Final</netty.version>
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <log4j2.version>2.25.5</log4j2.version>
        <tomcat.version>10.1.60</tomcat.version>
    </properties>

    <!-- 安全升级：显式锁定非 Spring Boot BOM 管理的传递依赖版本，
         修复 OSV-Scanner/Trivy 命中的 CVE（这些依赖无对应 Spring Boot 属性可覆盖） -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>1.26.0</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>3.22.0</version>
            </dependency>
            <!-- 1.84 → 1.85：关闭 CVE-2026-8763（CRITICAL，rfc822Name/URI 尾点绕过 Name Constraints）
                 与 CVE-2026-13506（HIGH）。1.85 经 OSV 查询为 0 命中。 -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>1.85</version>
            </dependency>
            <!-- 修复：minio 8.6.0 的 pom 声明 okhttp 5.1.0，但 okhttp 5.x 经 Gradle Module
                 Metadata 发布、其 Maven 主 jar 为空占位符（仅 MANIFEST，无任何 class），
                 而 minio 8.6.0 字节码实际引用 okhttp3 包（4.x 命名空间，如 okhttp3.HttpUrl）。
                 空 jar 导致 classpath 缺失 okhttp3.HttpUrl，编译报「找不到符号 HttpUrl」。
                 此处显式将 okhttp 钉回 4.12.0（4.x 最终版，含 okhttp3 包），与 minio 字节码匹配。 -->
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>4.12.0</version>
            </dependency>
            <!-- 修复：minio 8.6.0 传递引入 guava 33.4.8-jre，命中 CVE-2026-102554（HIGH，
                 反序列化期间内存分配不受限导致 DoS）。修复版为 33.7.2；Guava 只发布
                 `-jre` / `-android` 后缀构件，Maven Central 上**不存在**裸 `33.7.2`，
                 故锁定 `33.7.2-jre`（同大版本内小版本升级，二进制兼容）。
                 实测：33.7.2-jre 在 aliyun/Central 均可解析（HTTP 200）。 -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.7.2-jre</version>
            </dependency>
            <!-- 修复：minio 8.6.0 传递引入 snappy-java 1.1.10.7，命中两条 HIGH：
                 CVE-2026-108106（解压时无界内存分配 DoS）与 CVE-2026-93451（畸形压缩输入缓冲区溢出）。
                 修复版 1.1.10.9（同 1.1.10.x 线，补丁级升级）。 -->
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>1.1.10.9</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

