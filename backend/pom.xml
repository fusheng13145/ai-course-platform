    <build>
        <plugins>
            <!-- 构建环境强制校验 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,25)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.6.3,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Spring Boot 打包插件 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- 编译插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <release>${maven.compiler.release}</release>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <fork>true</fork>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                            <version>${project.parent.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- 资源文件编码 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>

            <!-- 单元测试 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                        <exclude>**/*ITCase.java</exclude>
                        <exclude>**/*IntegrationTest.java</exclude>
                        <exclude>**/Abstract*.java</exclude>
                    </excludes>
                    <argLine>@{argLine}</argLine>
                </configuration>
            </plugin>

            <!-- 集成测试 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <id>integration-tests</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                        <include>**/*ITCase.java</include>
                        <include>**/*IntegrationTest.java</include>
                    </includes>
                    <argLine>@{argLine}</argLine>
                </configuration>
            </plugin>

            <!-- 覆盖率探针数据落在 ${user.home}（中文路径限制，见 jacoco 插件注释），
                 不在 target/ 内，故 clean 默认删不到；这里显式纳管，避免留档串味。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>clean-jacoco-exec</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <filesets>
                                <fileset>
                                    <directory>${user.home}</directory>
                                    <includes>
                                        <include>jacoco-${project.artifactId}*.exec</include>
                                    </includes>
                                    <followSymlinks>false</followSymlinks>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 测试覆盖率统计 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <!--
                  exec 文件一律落在纯 ASCII 路径（${user.home}），规避工作目录含中文（如“大创赛”）时
                  JaCoCo 探针静默失效、exec 文件不生成、覆盖率门禁被整体跳过（BUILD SUCCESS 却无覆盖数据）的问题。

                  单元与集成两套数据写进同一份 exec，但 append 取值刻意不同（2026-10-07，CI 红灯根因 D）：
                    prepare-agent（surefire 先跑）          → append=false，**截断**重写，本次构建从这里起算
                    prepare-agent-integration（failsafe 后跑）→ append=true ，**追加**到同一文件
                  两个 fork 若共用 destFile 而都取默认 append=true，会把历史构建（含已改名的类、已删的测试）
                  一起叠加进来，本机读数系统性偏高，于是出现「本机 87.6% 绿、CI 单次运行 84.8% 红」的分裂；
                  若都取 append=false，后跑的 failsafe 又会把 surefire 的数据整份覆盖掉，门禁只统计 12 例 IT。
                  现在「首个 fork 截断 + 后续 fork 追加」＝单次构建的单元∪集成并集，与是否 clean、与历史无关，
                  本机复现值 ≡ CI 单次运行值。注意：此写法前提是每个阶段的 forkCount=1（当前默认值），
                  多个 fork 并发追加同一文件会互相踩写。
                  同一前提也约束跨进程并发：destFile 基于 ${user.home} 而非 target/，所有 git worktree
                  （含并行子 agent 的构建）共用这一份路径。一旦有两个覆盖率构建同时在跑，先启动的那个会被
                  后启动的 prepare-agent（append=false）整份截断，门禁读到的行数只剩残值（实测曾跌到
                  LINE 0.12 / BRANCH 0.02，而 2821 单元 + 12 集成全部通过）。结论：本机跑带覆盖率的
                  verify 必须串行，不要并行两个 Maven 构建。
                  `mvn clean` 顺带删除这三个文件（见上方 maven-clean-plugin 的 clean-jacoco-exec 执行），仅作留档卫生。
                -->
                <configuration>
                    <!-- destFile：探针写入位置；dataFile：report/check 读取位置。两者必须一致且为纯 ASCII 路径。 -->
                    <destFile>${user.home}/jacoco-${project.artifactId}.exec</destFile>
                    <dataFile>${user.home}/jacoco-${project.artifactId}.exec</dataFile>
                    <haltOnFailure>true</haltOnFailure>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <append>false</append>
                        </configuration>
                    </execution>
                    <!-- pre-integration-test 阶段重写 argLine，使 failsafe 的 fork 追加到同一份 exec 而不是覆盖 -->
                    <execution>
                        <id>prepare-agent-integration</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                        <configuration>
                            <append>true</append>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <!--
                                              覆盖率基线（2026-10-07 采集口径修正后诚实复测）：
                                                · 补测前（2579 单测 + 12 IT 并集，341 个 main 类，无测试类混入）
                                                  LINE 84.84% / BRANCH 61.84%，距门禁差 **27 行 / 211 个分支**；
                                                · 补测后（2830 单测 + 12 IT，同日 21:56 串行 clean verify）
                                                  LINE 89.16% / BRANCH 70.62%，余量 +669 行 / +375 分支。
                                              ⚠️ 下面 0.85 / 0.65 的定档依据是 2026-08-29 记的「LINE 93.6% / BRANCH 73.4%」，
                                              而那份读数是被 append=true 跨构建叠加历史 exec 污染出来的（见手册 §24.2.3 根因 D），
                                              即这条线在口径修正前从未被诚实达到过。
                                              处置：**阈值不降**，靠补真实测试达标（8 份 *CoverageTest 共 251 例，禁为测试改生产代码）；
                                              任何调整都必须先用 `mvn -B clean verify`（串行）复现出可比的诚实读数，并在评审里给理由。
                                            -->
                                            <minimum>0.85</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.65</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 静态代码分析：发现潜在 Bug、性能问题和不良实践 -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.8.6.6</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Low</threshold>
                    <failOnError>true</failOnError>
                    <excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 生产发布构件（D-A5 ② + 补强④，2026-11-05）：
             仅在显式 -Pprod-jar 时把 db/seed-demo（V5 富种子 + V6 示范课）排除出 jar。
             默认构建/本地开发/test 完全不启用，application.yaml 的双 location 与演示能力不变。 -->
        <profile>
            <id>prod-jar</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>db/seed-demo/**</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 依赖漏洞扫描 -->
        <profile>
            <id>security-scan</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>${dependency-check.version}</version>
                        <configuration>
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                            <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
                            <suppressionFiles>
                                <suppressionFile>${project.basedir}/dependency-check-suppressions.xml</suppressionFile>
                            </suppressionFiles>
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                            </formats>
                            <skipTestScope>true</skipTestScope>
                            <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                            <nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
                            <nodeAuditAnalyzerEnabled>false</nodeAuditAnalyzerEnabled>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
