# ============================================================
# Docker 环境变量模板（生产环境必须修改）
# 使用方法：复制本文件为 .env 后填入真实值
#   Linux/Mac:  cp .env.example .env
#   Windows:    copy .env.example .env
# docker compose 会自动读取同级目录下的 .env 文件
#
# 生成强密码命令（务必使用随机值，不要手写）：
#   Linux/Mac:  openssl rand -base64 32
#   Windows PS: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 24 | % {[char]$_})
# ============================================================

# MySQL 超级管理员密码（backend 数据源密码与之保持一致）
# 要求：至少 16 位，包含大小写字母+数字+特殊字符
MYSQL_ROOT_PASSWORD=your_strong_mysql_password_16_chars_min

# JWT 签名密钥，至少 256 位（32 字节）随机字符串 Base64 编码
# 弱密钥将导致令牌可被离线暴力破解和伪造
JWT_SECRET=your_jwt_secret_key_change_me_at_least_32_chars

# 深度求索（DeepSeek）大模型 API Key
# 访问 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 邮件服务（SMTP）凭据，用于发送验证码/通知邮件
# QQ邮箱 SMTP 授权码获取路径：QQ邮箱 → 设置 → 账户 → POP3/SMTP服务 → 生成授权码
MAIL_USERNAME=your-email@qq.com
MAIL_PASSWORD=your-smtp-auth-code
