# ============================================================
# Docker 环境变量模板（生产环境必须修改）
# 使用方法：复制本文件为 .env 后填入真实值
#   Linux/Mac:  cp .env.example .env
#   Windows:    copy .env.example .env
# docker compose 会自动读取同级目录下的 .env 文件
#
# ---- 生成强密钥（务必使用随机值，不要手写）----
#   推荐（已内置 PasswordPolicy 自检，**生成即必过**）：
#     python scripts/generate-secrets.py           # 打印全部强密钥
#     python scripts/generate-secrets.py --write   # 直接写入 .env 对应键
#
#   手工生成时请**按变量性质分别选用**，不要一把梭：
#     · JWT_SECRET —— 只要求 ≥32 字节（无字符类别要求）
#         Linux/Mac:  openssl rand -base64 48        # 输出 64 字符；启动器亦推荐 48
#     · APP_ADMIN_INITIAL_PASSWORD 等「口令」类 —— 须同时含大小写字母+数字+特殊字符，且 **8-32 位**
#         ⚠ 不要用 `openssl rand -base64 32`：输出 44 字符，**超出 8-32 上限** → PasswordPolicy 拒启
#         ⚠ 不要用纯字母数字的一行命令：缺「特殊字符」类别 → 同样拒启
#         这类口令请直接用上面的 generate-secrets.py（脚本已保证四类字符各至少取一）
# ============================================================

# MySQL 超级管理员密码（backend 数据源密码与之保持一致）
# 要求：至少 16 位，包含大小写字母+数字+特殊字符
MYSQL_ROOT_PASSWORD=your_strong_mysql_password_16_chars_min

# 业务库账户口令（可选，安全增强）：后端连接与账户创建使用**同一回退式**
#   ${MYSQL_APP_PASSWORD:-${MYSQL_ROOT_PASSWORD}}（见 docker-compose.yml 的 backend 服务
#   与 scripts/init-app-db-user.sh），故「留空」在**首次部署**下同样可正常连接——
#   不会出现「用 aicourse_app 账户 + root 口令」的鉴权不一致。
# 置为本值可让应用账户与 root 使用**不同口令**（最小权限 + 口令隔离，推荐生产采用）。
# ⚠ 升级 / 轮换场景（mysql-data 卷已存在、或改动本值后）：库内账户口令不会自动更新，
#   需**手动重跑**初始化脚本对齐（该脚本已幂等）：
#     docker compose exec -T mysql bash < scripts/init-app-db-user.sh
#   或重置 mysql-data 卷重新初始化。
MYSQL_APP_PASSWORD=

# JWT 签名密钥，至少 256 位（32 字节）随机字符串 Base64 编码
# 弱密钥将导致令牌可被离线暴力破解和伪造
JWT_SECRET=your_jwt_secret_key_change_me_at_least_32_chars

# Redis 密码（生产环境必设，与后端 SPRING_DATA_REDIS_PASSWORD 同步）
# 留空 = Redis 无认证启动，仅限本地开发；一旦设置，后端与健康探针自动携带密码
REDIS_PASSWORD=your_strong_redis_password

# 种子 admin 初始口令（生产必设！index.sql 内置的 admin 账号为弱口令哈希，
# 配置后启动时自动替换为强口令；必须满足：8-32 位，含大小写字母、数字与特殊字符）
# ⚠ 下方占位符是**刻意不合规**的：37 字符（超出 8-32 上限），且不含小写字母与数字
#   → 三重不满足 PasswordPolicy 正则（backend/src/main/java/com/aicourse/util/PasswordPolicy.java:20）。
#   留用占位符即触发 AdminSeedPasswordInitializer 启动期 fail-fast 并**拒绝启动**。
#   这是**有意的设计**（与 JWT_SECRET / MYSQL_ROOT_PASSWORD 等 ${VAR:?} 必填变量同一哲学）：
#   宁可拒绝启动，也不允许「照抄 .env.example」变成仓库内公开的已知 admin 口令。
#   → 请务必替换为真实强口令；**不要**为了让服务起得来而把本行改回"能通过校验的示例值"。
APP_ADMIN_INITIAL_PASSWORD=CHANGE_ME_SET_A_STRONG_ADMIN_PASSWORD

# 演示账号开关（生产必设 false！）
# index.sql / V1 迁移内置 8 个演示账号，共用弱口令 123456：
#   admin / teacher / teacher2 / student / student2 / student3 / student4 / student5
#   false = 启动时把「仍为出厂弱口令」的演示账号停用(is_active=0)并重置为不可知随机口令
#           （已由管理员改密的账号一律不覆盖；加固幂等）
#   true  = 保留演示账号（仅用于本地开发/测试）；与 prod profile 同时出现会 fail-fast 拒绝启动
DEMO_ACCOUNTS_ENABLED=false

# ---- 文件式密钥注入（可选，用于替代上面的明文变量）----
# 应用已内置 spring.config.import=optional:configtree:/run/secrets/
# 即：容器内 /run/secrets/<变量名> 文件的内容可作为该变量使用。
# 支持 Docker Compose secrets、K8s Secret 卷、Vault Agent 渲染输出三种来源。
# 【务必】改用文件式密钥时需移除同名明文 env，否则 env 优先级更高会静默覆盖文件值。
# 【务必】容器内文件名必须与「该属性在 Spring 里被读取的形式」逐字一致：configtree 只做精确键名
#   查找，不做系统环境变量那种松散绑定。yaml 写了 ${XXX} 占位符的用大写蛇形名；只靠属性绑定的
#   用点分名（或 spring/data/redis/password 这样的嵌套目录）。
#   例：/run/secrets/JWT_SECRET、/run/secrets/SPRING_DATASOURCE_PASSWORD、
#       /run/secrets/spring.data.redis.password（Redis 口令必须是这个写法，不是 SPRING_DATA_REDIS_PASSWORD）
# 详见 docs/部署文档.md 的文件式密钥（configtree）章节

# 深度求索（DeepSeek）大模型 API Key
# 访问 https://platform.deepseek.com/api_keys 获取
# ⚠️ 值必须是**纯 ASCII**（DR-82）：把中文说明粘在同一行键值后面会让 Authorization 头无法承载，
#    请求在发出前就失败；说明请另起注释行。以 `sk-` 开头且不等于本占位串才算"配了 Key"。
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# LLM 供应商选择与端点（DR-84）：deepseek（默认）/ openai / qwen / ollama
# 三家的 base-url 与 model 都是"环境变量 + 默认值"形式，**不填即完全等同旧行为**；
# 需要接任意 OpenAI 兼容网关（自建 one-api、硅基流动、火山方舟等）时改这里即可——
# 在此之前，非 DeepSeek 域名的 Key 只会打向 api.deepseek.com 并必然 401，
# 现象与"密钥本身无效"完全同形（这正是 DR-84 登记的阻塞点）。
AI_PROVIDER=deepseek
# ⚠ Java 的 RoutingLLMProvider 优先读 DB `system_configs.ai.provider`，且该值被
#   SystemConfigServiceImpl 的 @Cacheable 缓存。切换必须二选一：
#   ①管理员 POST /api/admin/ai/provider {"provider":"ollama"}（带 @CacheEvict，即时生效）
#   ②UPDATE system_configs SET config_value='ollama' WHERE config_key='ai.provider'
#     后**重启后端**清缓存（只改库不重启，Java 仍会解析成旧值）
#   同时改本键并重启 RAG 8002（它读进程环境）。回切 deepseek 反向执行，DEEPSEEK_API_KEY 保留。
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus
# 本地 Ollama（无需 API Key）：AI_PROVIDER=ollama 时生效；先在本机执行
# `ollama serve` 与 `ollama pull deepseek-r1:8b`。容器内 localhost 指容器自身，
# Compose 部署请用 http://host.docker.internal:11434。
# ⚠ Java 编排与 Python RAG 引擎（8002 问答生成）共用这四个键；start-engines.py 会把它们
#    导出给 RAG 子进程。RAG 的降级语义不变：Ollama 不可达/超时/返回空答案时仍回落
#    抽取式回答（有检索资料）或 UNAVAILABLE（无资料），不会因此把 8002 判为下线；
#    其 `/api/v1/rag/health` 额外返回 `llm.available/detail` 供排障。
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=deepseek-r1:8b
# 留空=由模型模板决定是否思考；true/false=显式要求开启/关闭（思考内容始终不进正式答案）
# OLLAMA_THINK=
# 容器内访问宿主 Ollama 的专用覆盖（compose 的 rag-service 默认用 host.docker.internal；
# 单独覆盖可避免把本机 C 路径的 OLLAMA_BASE_URL=localhost 带进容器）：
# RAG_OLLAMA_BASE_URL=http://host.docker.internal:11434
# Linux 宿主需 host.docker.internal → 宿主网关映射；compose 已为 rag-service 配
# extra_hosts: host.docker.internal:host-gateway，Windows/macOS Docker Desktop 原生支持，无需额外设置。

# 邮件服务（SMTP）验证码通道。
# ⚠ EmailServiceImpl 自建 Jakarta Mail Session，读取的是顶层 mail.*（不是 spring.mail.*）；
#   但 Spring Boot 的 mail 健康指示器读 spring.mail.*，两者都绑定下面同一组 MAIL_* 变量。
# 必填：MAIL_USERNAME（完整发件邮箱）、MAIL_PASSWORD（邮箱 SMTP「授权码」，不是登录密码）。
# 端口口径二选一：
#   465 SSL：MAIL_PORT=465 + MAIL_SSL_ENABLE=true + MAIL_STARTTLS_ENABLE=false
#   587 STARTTLS：MAIL_PORT=587 + MAIL_SSL_ENABLE=false + MAIL_STARTTLS_ENABLE=true
# 开发调试：未填账号且 MAIL_DEV_LOG_CODE=true 时，验证码只打印到后端日志；
# 生产 profile 强制 dev-log-code=false，缺凭据即失败，不会静默冒充已发送。
# QQ邮箱 SMTP 授权码获取路径：QQ邮箱 → 设置 → 账户 → POP3/SMTP服务 → 生成授权码
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_SSL_ENABLE=true
MAIL_STARTTLS_ENABLE=false
MAIL_FROM_NAME=AI智能课程平台
MAIL_DEV_LOG_CODE=true

# ---- 生产安全开关 ----
# 本应用本身不终止 TLS，必须置于 TLS 终止的反向代理之后。
# ⚠ 2026-10-17 核实并更正一处过期自述：**后端已不是** `forward-headers-strategy: framework`，
#   现行值为 `none`（backend/src/main/resources/application.yaml:131），协议/安全标记的修正
#   改由 config/TrustedForwardedProtoFilter **只读 X-Forwarded-Proto** 完成（该类注释记录了改造原因）。
#   ⇒ 反代必须回传 X-Forwarded-Proto: https，requiresSecure() 才认得出安全通道；
#     旧文案里「framework 会用 XFF 最左端覆写 getRemoteAddr()」这条推导链已随之失效，勿再据其决策。
#   · 纯 HTTP 评估（仅本机/受信内网，--profile full 明文单机栈，无 TLS 终止）：置 false，否则全站 API 被 302 到不存在的 443 而不可用。
#   · 生产（置于 TLS 终止反代之后）：置 true。此时反代必须回传 X-Forwarded-Proto: https。
# 不要为了让本地跑起来而盲目置 true；务必按部署形态二选一，并保持两侧口径一致。
# 注：本机启动器（start.bat → scripts/start-all.py）会**强制**把这三键置为
#   false/false/false 再交给后端进程，故本行在本机无论怎么填都不生效——这是有意的开发态护栏
#   （见 start-all.py 的 backend_env()），生产口径只经 docker-compose / prod profile 落地。
COOKIE_SECURE=false
REQUIRE_HTTPS=false
CSRF_ENABLED=true

# ---- 客户端 IP 取值来源（安全决策用，2026-09-16 上线前全检新增；2026-10-17 DR-66 收口后重写）----
# 本变量绑定 app.security.trust-proxy-header，消费者是 util/TrustedClientIpResolver
# （base 默认 false 见 application.yaml，prod 默认 true 见 application-prod.yml:51）。
# ⚠ 2026-10-17 起它**同时**管着两件事，不再"只管节流"：
#   · 登录失败节流的计数键（既有作用面）；
#   · config/RateLimitFilter 的限流键（DR-66 收口新增作用面）。
#     该过滤器原先自带一个 `ratelimit.trust-proxy-header` 开关，而全仓库没有任何 yml/compose/CI
#     给它赋过值，故它恒为 false 且**只认 XFF 最左段**；本仓 server.forward-headers-strategy
#     已于 P0-2 收为 none（不再由 Spring 用 XFF 改写 remoteAddr），于是置于反代之后时
#     getRemoteAddr() 就是**边缘代理自身地址**——全站所有客户端落进同一个限流桶，
#     "登录 10 次/60 秒"实际变成全部署总额度。现已删除该悬空键，限流键一律走同一个 resolver。
#   ⇒ 回归位：RateLimitFilterTest.behindTrustedProxy_keyUsesSameIpAsThrottleResolver
#     （改前实测键为 172.18.0.3，即 nginx 自身地址）、
#     RateLimitFilterTest.appendSemanticsProxy_forgedXffLeftmost_notUsedAsKey
#     （追加语义代理下，客户端可控的 XFF 最左段不得成为限流键）。
#   · true  = 信任受信反代覆写的 X-Real-IP（本仓库 frontend/nginx.conf 以 $remote_addr 覆写）。
#             compose 单机栈的边缘代理即 frontend(nginx)，故默认 true。
#   · false = 不信任任何代理头，以 TCP 对端为准。适用于应用**被直连暴露**（前面没有受信反代）的场景。
# ⚠ 真正的稳妥做法仍是**不要把后端端口对外直连发布**，只暴露 nginx(80/443)。
# ⚠ 教室/机房共用出口 IP：即使本项为 true，同一出口下的所有学生仍共享一个限流桶，
#   演示前应按人数上调 RATELIMIT_LOGIN_LIMIT / RATELIMIT_AI_LIMIT / RATELIMIT_VERIFY_LIMIT /
#   RATELIMIT_REGISTER_LIMIT（四类阈值全部有 env 落点，见 application.yaml 的 ratelimit: 段）。
TRUST_PROXY_HEADER=true

# ---- 跨域白名单（CORS，逗号分隔；生产填真实前端域名）----
# 留空 = 不开放任何跨域来源（fail-closed）。例如：https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=https://your-domain.example.com

# ---- 限流阈值（A 路径断链 #14：yml 有占位符，容器形态必须经 compose env 才生效）----
# 对应 application.yaml 的 ratelimit: 段；容器形态若不在 .env 写这些键，
# compose 会按下面的默认值注入（与本机 yml 默认一致），改阈值填这里即可。
# ⚠ DR-73 教训：yml 有落点而编排到不了 = 改了不生效且不报错；此前 .env.example 无键行、
#   compose 不注入，容器里调阈值永远不生效。现由 docker-compose.yml 的 ratelimit 段显式透传。
# 每项均为「次数 / 窗口秒」；按人数放宽时四类一起看（教室共用出口 IP 会共享一个桶）。
RATELIMIT_ENABLED=true
RATELIMIT_REDIS_ENABLED=true
RATELIMIT_LOGIN_LIMIT=10
RATELIMIT_LOGIN_WINDOW=60
RATELIMIT_AI_LIMIT=20
RATELIMIT_AI_WINDOW=60
RATELIMIT_VERIFY_LIMIT=5
RATELIMIT_VERIFY_WINDOW=60
RATELIMIT_REGISTER_LIMIT=20
RATELIMIT_REGISTER_WINDOW=3600

# ---- 检索增强（RAG）----
# Java 端保留 RAGService 标准化接口 + HTTP 代理到 Python RAG 服务（8002）。
# R1 部署开关：**本机开发/验收不写 RAG_ENABLED** —— 启动器起 8002 就自动注入 true
# （scripts/start-all.py 的 backend_env() 按端口置位）；显式写 false/0/no 才关闭。
# 容器/生产形态（D-A4=②，2026-11-05）：compose 已按 `${RAG_ENABLED:-true}` 默认开启；
# 未带 python profile 时 8002 不可达，后端按既有语义降级，不会启动失败。
# 契约见 docs/项目手册.md 第八部分；Python 端真实混合检索引擎已就绪
# （rag_engine.py：BM25+向量，需 pip install -r requirements-engine.txt）。
RAG_BASE_URL=http://localhost:8002
# R3 主路径图谱增强：缺省开启（图不可达时静默退化为纯检索）；显式 false 关闭
# RAG_GRAPH_ENABLED=true
# 可选调优（一般无需改动）：
# RAG_CONNECT_TIMEOUT=5  RAG_READ_TIMEOUT=60  RAG_MAX_RETRIES=2  RAG_DEFAULT_TOP_K=5

# ---- 知识图谱（KG）----
# Java 端保留 KnowledgeGraphContract 标准化接口 + HTTP 代理到 Python 知识图谱服务（8001）。
# R1 部署开关：同 RAG——本机不写 KG_ENABLED，起 8001 即由启动器置 true；显式 false 才关闭。
# Python 端真实引擎已就绪：Neo4j 后端（kg_store.py，:Kp 标签 + Cypher shortestPath），
# 未配置或不可达时自动退回内存基线；KG_BACKEND=memory|neo4j|auto 可显式指定。
KG_BASE_URL=http://localhost:8001
# 可选调优（一般无需改动）：
# KG_CONNECT_TIMEOUT=5  KG_READ_TIMEOUT=30  KG_MAX_RETRIES=2  KG_RAG_MAX_HOPS=2

# ---- LoRA 微调（8003，职责边界 2026-08-13，对应 docker compose 变量 FT_*）----
# 微调引擎（LoRA/PEFT）由团队另一成员负责；Java 端 LLMFineTuneServiceImpl 已就绪。
# Python 端接入后置 FT_ENABLED=true 并配置 FT_BASE_URL 即可启用
# （契约见 docs/项目手册.md 第八部分 §33）。
# 本机真实启动（非 Docker，cwd=python-services/fine_tune_service）：
#   pip install -r requirements-engine.txt
#   FT_DATA_DIR=<绝对路径>/data FT_PUBLIC_BASE=http://localhost:8003 \
#   python -m uvicorn lora_service:app --host 127.0.0.1 --port 8003
# 依赖/权重缺失时 /health 会如实返回 engine_available=false，不要用占位返回冒充可用。
# 生成路径开关 FT_LLM_PROVIDER（默认 engine）：
#   engine = 基座 + LoRA adapter 真实推理（mode=ENGINE）；现有 adapter 基于 Qwen2.5-0.5B，
#            换基座会维度不匹配，只能在原基座上重训；
#   ollama = 走本机 Ollama（mode=OLLAMA），复用 RAG 的 OLLAMA_BASE_URL/OLLAMA_MODEL，
#            用于「要更好输出质量、但不要求 LoRA 权重」的场景。
# 可选覆盖：FT_OLLAMA_BASE_URL / FT_OLLAMA_MODEL / FT_OLLAMA_TIMEOUT（默认 180 秒）。
FT_ENABLED=false
FT_BASE_URL=http://localhost:8003
FT_LLM_PROVIDER=engine

# ---- 运维增强（可选，对应 docker compose 的 ops / monitor profile）----
# MySQL 定时备份保留天数（mysql-backup 服务，默认 14 天滚动清理）
# 启用：docker compose --profile full --profile ops up -d --build
BACKUP_RETENTION_DAYS=14
# 备份周期（秒），默认 86400 = 每日一轮。DR-29（2026-10-07 真机实测）：
# 备份脚本本身是一次性导出，循环由 mysql-backup 的入口守护；原先入口 chmod 在只读挂载上失败，
# 导致备份从未执行过（容器无限重启）。调小可用于本机验证，如 3600。
BACKUP_INTERVAL_SECONDS=86400

# 监控端点（/api/actuator/prometheus）鉴权：独立 Basic 鉴权链（与业务 JWT 链路隔离，非 ADMIN 角色）。
# 凭据为监控专用账号 APP_ACTUATOR_BASIC_*，口令留空则抓取 fail-closed（拒绝）。
# 启用 monitor profile 且无反向代理鉴权时（内网/演示），可置 false 放开 Prometheus 抓取。
APP_ACTUATOR_SECURED=true

# ---- 监控抓取专用 Basic 账号（Prometheus ←→ backend 共用，必须一致）----
# 仅当启用 monitor profile 且 APP_ACTUATOR_SECURED=true 时生效。
# Prometheus 经 HTTP Basic 鉴权抓取 /api/actuator/prometheus；口令留空则抓取 fail-closed（拒绝）。
# 用户名默认 monitor；口令须为强随机值，且与 backend 的 APP_ACTUATOR_BASIC_PASSWORD 完全一致。
#
# ⚠️ DR-30（2026-10-07 真机实测）：Prometheus **不会插值自己配置文件里的环境变量**，
#    所以 monitor profile 下这枚口令还需一份文件式凭据（backend 仍读本行的 env，两侧同源）：
#      mkdir -p deploy/secrets
#      printf %s "$APP_ACTUATOR_BASIC_PASSWORD" > deploy/secrets/actuator_basic_password
#    （`deploy/secrets/*` 已被 .gitignore 排除；文件末尾不可有换行，否则恒 401。）
# 想放到仓库外：ACTUATOR_BASIC_PASSWORD_FILE=/abs/path/to/file
# ⚠️ 用户名侧只能字面写死在 monitoring/prometheus/prometheus.yml（username: "monitor"）；
#    改本行的 APP_ACTUATOR_BASIC_USER 必须同步改那一个词，否则 backend 抓取 401。
APP_ACTUATOR_BASIC_USER=monitor
APP_ACTUATOR_BASIC_PASSWORD=your_strong_monitor_password
# APP_ACTUATOR_BASIC_PASSWORD_FILE=./deploy/secrets/actuator_basic_password

# Prometheus/Grafana 监控（启用：docker compose --profile full --profile monitor up -d --build）
# 生产必须修改 Grafana 默认口令！
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_strong_grafana_password

# ---- 告警通知渠道（monitor profile 随 Prometheus/Grafana 自动启动 Alertmanager）----
# ⚠️ 本键在仓库内**没有任何代码消费者**（量具 `scripts/audit-stats.py` 的
#    「example 中无任何代码消费者的键名」行会点名它）：Alertmanager 不插值自己配置文件里的
#    环境变量（DR-30 已实测），compose 侧的注入也已于 2026-10 撤除（docker-compose.yml:450 记录原因）。
#    ⇒ 填在这里**永远不会生效**。要让告警真正推出去，直接改
#      monitoring/prometheus/alertmanager.yml 里 webhook 接收器的**字面 url**。
#    保留本行只为与历史模板保持键位一致；空值即为唯一正确取值。
# 如需邮件通知，取消 alertmanager.yml 中 email-admin 接收器注释并配置 SMTP_* 变量。
ALERTMANAGER_WEBHOOK_URL=

# ---- 前端监控上报（本机/构建路径已实现，镜像路径未接）----
# 前端 Vue 全局错误经 src/monitoring 模块采集，配置后上报到后端 /api/monitor/frontend-error
# （MonitorController.java:42）。该路径在 DoubleSubmitCsrfFilter.java:70 豁免 CSRF，
# 但**不是匿名放行**：MonitorController 是类级 @PreAuthorize("isAuthenticated()")，未登录时上报会得
# 401（上报失败一律静默吞掉，不二次放大故障，但匿名页的错误收不到）。旧文案的「匿名放行」不成立。
# ⚠ 2026-10-17 核实并更正旧自述「当前前端尚未实现该上报模块，此变量为预留配置，配置后不生效」——
#   该说法已不成立：frontend/src/monitoring/index.ts:26 读它、main.ts:65/73 已接线，
#   且有单测 src/monitoring/__tests__/index.test.ts。**留空（默认）= 仅控制台输出、不上报，零副作用。**
#   仍未接的是**镜像构建侧**：frontend/Dockerfile 没有 `ARG VITE_MONITOR_ENDPOINT`，
#   compose 也未传该 build arg ⇒ 容器里构建的前端读不到它。要在容器形态启用需先补这两处（手册 DR-65 残项）。
VITE_MONITOR_ENDPOINT=

# ---- MySQL 备份异地同步（可选，ops profile）----
# 备份完成校验通过后，经 rclone 同步到远端（S3/OSS 等）实现异地容灾。
# 需在 mysql-backup 镜像中安装 rclone 并配置凭据（当前镜像为官方 mysql:8.4.11 未内置 rclone，
# 生产启用时请改为内置 rclone 的自定义镜像）。留空 = 仅本地滚动保留，不做异地同步。
BACKUP_REMOTE_SYNC=

# ---- 知识图谱 Neo4j（Python 侧，docker compose --profile python 或 --profile rag）----
# Neo4j 认证口令（必改，compose 对 neo4j 服务 fail-fast 校验）
NEO4J_PASSWORD=
# kg_service（8001）Neo4j 后端连接（auto 模式：可连通即用真实引擎，否则内存基线）
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
# KG_BACKEND=auto  # memory | neo4j | auto
# ---- rag_service（8002）真实引擎可选配置（均有默认值，一般无需改动）----
# RAG_DATA_DIR=./data          文档与索引持久化目录
# RAG_EMBED_MODEL=BAAI/bge-small-zh-v1.5  向量模型（首次建索引自动下载）
# 容器形态（D-A4②）的嵌入权重通路：
#   HF_ENDPOINT=https://hf-mirror.com    HuggingFace 镜像；构建期 build-arg + 运行期 env
#   HF_HOME=/models/hf                   容器内固定缓存目录，compose 用 hf-cache 命名卷承载
#   HF_HUB_OFFLINE=1                     离线部署：先预置缓存再置 1；默认 0
# 离线预置（一次性，宿主执行）：
#   docker compose --profile python run --rm rag-service \
#     python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('BAAI/bge-small-zh-v1.5')"
#   # 之后置 HF_HUB_OFFLINE=1 再 up，rag_engine 命中缓存即 local_files_only 加载。
# RAG_CHUNK_SIZE=300  RAG_CHUNK_OVERLAP=50
# 生成走 DEEPSEEK_API_KEY / DEEPSEEK_MODEL（缺省时 /ask 返回抽取式回答，不报错）
# HF_HOME / HF_HUB_CACHE  模型缓存目录（不设即回落 ~/.cache/huggingface）
# ✅ 2026-10-17 DR-63 已修（处置 A：扩启动器导出名单）：引擎进程只调 os.getenv、不读 .env，
#    两个启动器（scripts/start-engines.py、scripts/start-all.py）现按
#    start-engines.py 的 ENGINE_EXPORTS 名单把这些键导出给 uvicorn 子进程：
#      KG  → NEO4J_USERNAME / NEO4J_PASSWORD / KG_BACKEND
#            （NEO4J_URI / KG_NEO4J_URI 另由 neo4j_uri 参数导出）
#      RAG → DEEPSEEK_MODEL / RAG_EMBED_MODEL / RAG_DATA_DIR / RAG_CHUNK_SIZE /
#            RAG_CHUNK_OVERLAP / HF_HOME / HF_HUB_CACHE
#            （DEEPSEEK_API_KEY 另由 api_key 参数导出，占位串不转）
#    ⚠️ 名单外的键不会到达引擎子进程；引擎若新增 os.getenv 读取而名单没跟上，
#    scripts/tests/test_start_engines.py 的集合包含用例会红（该文件不在 CI 收录范围，见其文件头）。
#    仍未收口的一条：offline_flags 只按 HF_HOME 定位缓存，而 rag_engine.py:112 优先读
#    HF_HUB_CACHE —— 两者同时设置时离线位可能判错目录（DR-63 备注，未修，需项目主定夺）。

# ============================================================
# ---- 宿主端口与绑定地址（可选，全部留空即用默认值）----
# 编排的资源命名与分组规范见手册 §24.2.1（项目名 `aicourse`、镜像前缀 `aicourse/*`、标签 `aicourse.*`）。
# 所有宿主端口**默认只绑 127.0.0.1**；下面的变量只在两种情况下需要动：
#   ① 端口被本机其它进程占用 → 只改数字（容器内端口不变）；
#   ② 需要让同组同学从别的机器访问 → 显式把对应 *_HOST_BIND 置 0.0.0.0（默认不要）。
# 典型冲突：本机原生 Redis 占 6379 → 设 REDIS_HOST_PORT=16379。
# ============================================================
# MYSQL_HOST_BIND=127.0.0.1
# MYSQL_HOST_PORT=3307
# REDIS_HOST_BIND=127.0.0.1
# REDIS_HOST_PORT=6379
# BACKEND_HOST_BIND=127.0.0.1
# BACKEND_HOST_PORT=8080
# 前端是本栈对外入口，默认仍回环；需局域网访问时显式 FRONTEND_HOST_BIND=0.0.0.0
# FRONTEND_HOST_BIND=127.0.0.1
# FRONTEND_HTTP_PORT=80
# PROMETHEUS_HOST_PORT=9090
# ALERTMANAGER_HOST_PORT=9093
# GRAFANA_HOST_PORT=3000
# LOKI_HOST_PORT=3100
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687
