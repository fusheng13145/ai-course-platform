# ============================================================
# Docker 环境变量模板（生产环境必须修改）
# 使用方法：复制本文件为 .env 后填入真实值
#   Linux/Mac:  cp .env.example .env
#   Windows:    copy .env.example .env
# docker compose 会自动读取同级目录下的 .env 文件
#
# ---- 生成强密钥（务必使用随机值，不要手写）----
#   推荐（已内置 PasswordPolicy 自检，**生成即必过**）：
#     python scripts/generate-secrets.py           # 打印全部强密钥
#     python scripts/generate-secrets.py --write   # 直接写入 .env 对应键
#
#   手工生成时请**按变量性质分别选用**，不要一把梭：
#     · JWT_SECRET —— 只要求 ≥32 字节（无字符类别要求）
#         Linux/Mac:  openssl rand -base64 48        # 输出 64 字符；start-backend.bat 亦推荐 48
#     · APP_ADMIN_INITIAL_PASSWORD 等「口令」类 —— 须同时含大小写字母+数字+特殊字符，且 **8-32 位**
#         ⚠ 不要用 `openssl rand -base64 32`：输出 44 字符，**超出 8-32 上限** → PasswordPolicy 拒启
#         ⚠ 不要用纯字母数字的一行命令：缺「特殊字符」类别 → 同样拒启
#         这类口令请直接用上面的 generate-secrets.py（脚本已保证四类字符各至少取一）
# ============================================================

# MySQL 超级管理员密码（backend 数据源密码与之保持一致）
# 要求：至少 16 位，包含大小写字母+数字+特殊字符
MYSQL_ROOT_PASSWORD=your_strong_mysql_password_16_chars_min

# 业务库账户口令（可选，安全增强）：后端连接与账户创建使用**同一回退式**
#   ${MYSQL_APP_PASSWORD:-${MYSQL_ROOT_PASSWORD}}（见 docker-compose.yml 的 backend 服务
#   与 scripts/init-app-db-user.sh），故「留空」在**首次部署**下同样可正常连接——
#   不会出现「用 aicourse_app 账户 + root 口令」的鉴权不一致。
# 置为本值可让应用账户与 root 使用**不同口令**（最小权限 + 口令隔离，推荐生产采用）。
# ⚠ 升级 / 轮换场景（mysql-data 卷已存在、或改动本值后）：库内账户口令不会自动更新，
#   需**手动重跑**初始化脚本对齐（该脚本已幂等）：
#     docker compose exec -T mysql bash < scripts/init-app-db-user.sh
#   或重置 mysql-data 卷重新初始化。
MYSQL_APP_PASSWORD=

# JWT 签名密钥，至少 256 位（32 字节）随机字符串 Base64 编码
# 弱密钥将导致令牌可被离线暴力破解和伪造
JWT_SECRET=your_jwt_secret_key_change_me_at_least_32_chars

# Redis 密码（生产环境必设，与后端 SPRING_DATA_REDIS_PASSWORD 同步）
# 留空 = Redis 无认证启动，仅限本地开发；一旦设置，后端与健康探针自动携带密码
REDIS_PASSWORD=your_strong_redis_password

# 种子 admin 初始口令（生产必设！index.sql 内置的 admin 账号为弱口令哈希，
# 配置后启动时自动替换为强口令；必须满足：8-32 位，含大小写字母、数字与特殊字符）
# ⚠ 下方占位符是**刻意不合规**的：37 字符（超出 8-32 上限），且不含小写字母与数字
#   → 三重不满足 PasswordPolicy 正则（backend/src/main/java/com/aicourse/util/PasswordPolicy.java:20）。
#   留用占位符即触发 AdminSeedPasswordInitializer 启动期 fail-fast 并**拒绝启动**。
#   这是**有意的设计**（与 JWT_SECRET / MYSQL_ROOT_PASSWORD 等 ${VAR:?} 必填变量同一哲学）：
#   宁可拒绝启动，也不允许「照抄 .env.example」变成仓库内公开的已知 admin 口令。
#   → 请务必替换为真实强口令；**不要**为了让服务起得来而把本行改回"能通过校验的示例值"。
APP_ADMIN_INITIAL_PASSWORD=CHANGE_ME_SET_A_STRONG_ADMIN_PASSWORD

# 演示账号开关（生产必设 false！）
# index.sql / V1 迁移内置 8 个演示账号，共用弱口令 123456：
#   admin / teacher / teacher2 / student / student2 / student3 / student4 / student5
#   false = 启动时把「仍为出厂弱口令」的演示账号停用(is_active=0)并重置为不可知随机口令
#           （已由管理员改密的账号一律不覆盖；加固幂等）
#   true  = 保留演示账号（仅用于本地开发/测试）；与 prod profile 同时出现会 fail-fast 拒绝启动
DEMO_ACCOUNTS_ENABLED=false

# ---- 文件式密钥注入（可选，用于替代上面的明文变量）----
# 应用已内置 spring.config.import=optional:configtree:/run/secrets/
# 即：容器内 /run/secrets/<变量名> 文件的内容可作为该变量使用。
# 支持 Docker Compose secrets、K8s Secret 卷、Vault Agent 渲染输出三种来源。
# 【务必】改用文件式密钥时需移除同名明文 env，否则 env 优先级更高会静默覆盖文件值。
# 【务必】容器内文件名必须与「该属性在 Spring 里被读取的形式」逐字一致：configtree 只做精确键名
#   查找，不做系统环境变量那种松散绑定。yaml 写了 ${XXX} 占位符的用大写蛇形名；只靠属性绑定的
#   用点分名（或 spring/data/redis/password 这样的嵌套目录）。
#   例：/run/secrets/JWT_SECRET、/run/secrets/SPRING_DATASOURCE_PASSWORD、
#       /run/secrets/spring.data.redis.password（Redis 口令必须是这个写法，不是 SPRING_DATA_REDIS_PASSWORD）
# 详见 docs/密钥注入与Secret管理.md §2.2

# 深度求索（DeepSeek）大模型 API Key
# 访问 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 邮件服务（SMTP）凭据，用于发送验证码/通知邮件
# QQ邮箱 SMTP 授权码获取路径：QQ邮箱 → 设置 → 账户 → POP3/SMTP服务 → 生成授权码
MAIL_USERNAME=your-email@qq.com
MAIL_PASSWORD=your-smtp-auth-code

# ---- 生产安全开关 ----
# 本应用本身不终止 TLS，必须置于 TLS 终止的反向代理之后（反代回传 X-Forwarded-Proto: https，后端已启用 forward-headers-strategy: framework）。
#   · 纯 HTTP 评估（仅本机/受信内网，--profile full 明文单机栈，无 TLS 终止）：置 false，否则全站 API 被 302 到不存在的 443 而不可用。
#   · 生产（置于 TLS 终止反代之后）：置 true。此时反代必须回传 X-Forwarded-Proto: https，requiresSecure() 才能正确识别为安全通道。
# 不要为了让本地跑起来而盲目置 true；务必按部署形态二选一，并保持两侧口径一致。
COOKIE_SECURE=false
REQUIRE_HTTPS=false
CSRF_ENABLED=true

# ---- 客户端 IP 取值来源（安全决策用，2026-09-16 上线前全检新增）----
# 决定「登录失败节流 / IP 限流」用哪个 IP 作为计数键，是安全控制，切勿随意改动：
#   · true  = 信任受信反代覆写的 X-Real-IP（本仓库 frontend/nginx.conf 以 $remote_addr 覆写）。
#             compose 单机栈的边缘代理即 frontend(nginx)，故默认 true。
#   · false = 以 TCP 对端地址为准，不信任任何代理头。适用于应用**被直连暴露**（前面没有受信反代）的场景。
# ⚠ 若应用可被绕过 nginx 直接访问（如 docker-compose.yml 中 backend 的 ports 直连发布），
#   置 true 会让客户端可伪造 X-Real-IP 从而绕过限流键的 IP 维度；反之置 false 时，
#   因后端启用了 forward-headers-strategy: framework，X-Forwarded-For 最左端同样会被伪造。
#   ⇒ 真正稳妥的做法是**不要把后端端口对外直连发布**，只暴露 nginx(80/443)。
TRUST_PROXY_HEADER=true

# ---- 跨域白名单（CORS，逗号分隔；生产填真实前端域名）----
# 留空 = 不开放任何跨域来源（fail-closed）。例如：https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=https://your-domain.example.com

# ---- 检索增强（RAG）----
# Java 端保留 RAGService 标准化接口 + HTTP 代理到 Python RAG 服务（8002）。默认关闭；
# 启用置 RAG_ENABLED=true 并配置 RAG_BASE_URL（契约见 docs/项目手册.md 第八部分）。
# Python 端真实混合检索引擎已就绪（rag_engine.py：BM25+向量，需 pip install -r requirements-engine.txt）。
RAG_ENABLED=false
RAG_BASE_URL=http://localhost:8002
# 可选调优（一般无需改动）：
# RAG_CONNECT_TIMEOUT=5  RAG_READ_TIMEOUT=60  RAG_MAX_RETRIES=2  RAG_DEFAULT_TOP_K=5

# ---- 知识图谱（KG）----
# Java 端保留 KnowledgeGraphContract 标准化接口 + HTTP 代理到 Python 知识图谱服务（8001）。默认关闭；
# 启用置 KG_ENABLED=true 并配置 KG_BASE_URL（契约见 docs/项目手册.md 第八部分）。
# Python 端真实引擎已就绪：Neo4j 后端（kg_store.py，:Kp 标签 + Cypher shortestPath），
# 未配置或不可达时自动退回内存基线；KG_BACKEND=memory|neo4j|auto 可显式指定。
KG_ENABLED=false
KG_BASE_URL=http://localhost:8001
# 可选调优（一般无需改动）：
# KG_CONNECT_TIMEOUT=5  KG_READ_TIMEOUT=30  KG_MAX_RETRIES=2  KG_RAG_MAX_HOPS=2

# ---- LoRA 微调（8003，职责边界 2026-08-13，对应 docker compose 变量 FT_*）----
# 微调引擎（LoRA/PEFT）由团队另一成员负责；Java 端 LLMFineTuneServiceImpl 已就绪。
# Python 端接入后置 FT_ENABLED=true 并配置 FT_BASE_URL 即可启用
# （契约见 docs/项目手册.md 第八部分 §33）。
FT_ENABLED=false
FT_BASE_URL=http://localhost:8003

# ---- 运维增强（可选，对应 docker compose 的 ops / monitor profile）----
# MySQL 定时备份保留天数（mysql-backup 服务，默认 14 天滚动清理）
# 启用：docker compose --profile full --profile ops up -d --build
BACKUP_RETENTION_DAYS=14

# 监控端点（/api/actuator/prometheus）鉴权：独立 Basic 鉴权链（与业务 JWT 链路隔离，非 ADMIN 角色）。
# 凭据为监控专用账号 APP_ACTUATOR_BASIC_*，口令留空则抓取 fail-closed（拒绝）。
# 启用 monitor profile 且无反向代理鉴权时（内网/演示），可置 false 放开 Prometheus 抓取。
APP_ACTUATOR_SECURED=true

# ---- 监控抓取专用 Basic 账号（Prometheus ←→ backend 共用，必须一致）----
# 仅当启用 monitor profile 且 APP_ACTUATOR_SECURED=true 时生效。
# Prometheus 经 HTTP Basic 鉴权抓取 /api/actuator/prometheus；口令留空则抓取 fail-closed（拒绝）。
# 用户名默认 monitor；口令须为强随机值，且与 backend 的 APP_ACTUATOR_BASIC_PASSWORD 完全一致。
APP_ACTUATOR_BASIC_USER=monitor
APP_ACTUATOR_BASIC_PASSWORD=your_strong_monitor_password

# Prometheus/Grafana 监控（启用：docker compose --profile full --profile monitor up -d --build）
# 生产必须修改 Grafana 默认口令！
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_strong_grafana_password

# ---- 告警通知渠道（monitor profile 随 Prometheus/Grafana 自动启动 Alertmanager）----
# Alertmanager 默认 webhook 占位端点为 http://localhost:9000/alerts（仅本机回环，不对外推送）。
# 生产请填入真实告警网关 URL（企业微信/钉钉/飞书群机器人 webhook、PagerDuty、自定义接收服务等），
# 告警才会真正推送；留空则告警仅在 Prometheus/Alertmanager UI 可见、不主动通知。
# 如需邮件通知，取消 monitoring/prometheus/alertmanager.yml 中 email-admin 接收器注释并配置 SMTP_* 变量。
# 注意：Alertmanager 不支持配置文件内 ${VAR} 插值，本变量不被 docker compose 自动读取；
# 生产填入真实 webhook 时须直接修改 monitoring/prometheus/alertmanager.yml 的字面 url。
ALERTMANAGER_WEBHOOK_URL=

# ---- 前端监控上报（可选，预留）----
# 前端 Vue 全局错误经 src/monitoring 模块采集，配置后上报到后端 /api/monitor/frontend-error（匿名放行）。
# 留空（默认）= 仅控制台输出，不上报。Docker 构建前端镜像时如需启用，
# 需在 frontend/Dockerfile 声明 ARG VITE_MONITOR_ENDPOINT 并以 ENV 写入构建产物。
# 注：当前前端尚未实现该上报模块，此变量为预留配置，配置后不生效。
VITE_MONITOR_ENDPOINT=

# ---- MySQL 备份异地同步（可选，ops profile）----
# 备份完成校验通过后，经 rclone 同步到远端（S3/OSS 等）实现异地容灾。
# 需在 mysql-backup 镜像中安装 rclone 并配置凭据（当前镜像为官方 mysql:8.0 未内置 rclone，
# 生产启用时请改为内置 rclone 的自定义镜像）。留空 = 仅本地滚动保留，不做异地同步。
BACKUP_REMOTE_SYNC=

# ---- 知识图谱 Neo4j（Python 侧，docker compose --profile rag）----
# Neo4j 认证口令（必改，compose 对 neo4j 服务 fail-fast 校验）
NEO4J_PASSWORD=
# kg_service（8001）Neo4j 后端连接（auto 模式：可连通即用真实引擎，否则内存基线）
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
# KG_BACKEND=auto  # memory | neo4j | auto
# ---- rag_service（8002）真实引擎可选配置（均有默认值，一般无需改动）----
# RAG_DATA_DIR=./data          文档与索引持久化目录
# RAG_EMBED_MODEL=BAAI/bge-small-zh-v1.5  向量模型（首次建索引自动下载）
# RAG_CHUNK_SIZE=300  RAG_CHUNK_OVERLAP=50
# 生成走 DEEPSEEK_API_KEY / DEEPSEEK_MODEL（缺省时 /ask 返回抽取式回答，不报错）
